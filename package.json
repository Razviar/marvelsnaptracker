{
  "name": "marvelsnaptracker",
  "productName": "Marvel Snap Tracker",
  "version": "1.3.0",
  "description": "Marvel Snap Tracker",
  "main": "./.webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "tslint -c tslint.json -p tsconfig.json --fix --format verbose",
    "compile": "node node_modules/typescript-go/bin/tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "watch": "node node_modules/typescript-go/bin/tsc -w",
    "clean": "rm -rf .webpack node_modules out package-lock.json"
  },
  "keywords": [],
  "author": {
    "name": "Razviar",
    "email": "admin@marvelsnap.pro"
  },
  "license": "MIT",
  "config": {
    "forge": "./forge.config.js"
  },
  "dependencies": {
    "auto-launch": "5.0.6",
    "axios": "1.20.0",
    "date-fns": "4.4.0",
    "electron-is-dev": "3.0.1",
    "error-stack-parser": "2.1.4",
    "form-data": "4.0.6",
    "jsonrepair": "3.15.0",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "node-abi": "4.35.0",
    "pretty-checkbox": "3.0.3",
    "source-map-support": "0.5.21",
    "update-electron-app": "3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@types/auto-launch": "5.0.5",
    "@types/lodash": "4.17.25",
    "@vercel/webpack-asset-relocator-loader": "1.11.0",
    "copy-webpack-plugin": "14.0.0",
    "csp-html-webpack-plugin": "5.1.0",
    "css-loader": "7.1.5",
    "dotenv-webpack": "9.0.0",
    "electron": "44.2.0",
    "file-loader": "6.2.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "node-loader": "2.1.0",
    "prettier": "3.9.6",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "tslint": "6.1.3",
    "tslint-loader": "3.5.4",
    "tslint-plugin-prettier": "2.3.0",
    "typescript": "6.0.3",
    "typescript-go": "npm:typescript@7.0.2",
    "webpack-hook-plugin": "1.0.7"
  },
  "optionalDependencies": {
    "macos-alias": "0.2.12"
  }
}
